# Run Claude Code against open models via Hugging Face Inference Providers.
# Usage: cp .env.example .env, fill in HF_TOKEN, then: set -a; source .env; set +a; claude
# .env is gitignored. Never commit a real token.

# Hugging Face token with "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

ANTHROPIC_BASE_URL=https://router.huggingface.co
ANTHROPIC_AUTH_TOKEN=${HF_TOKEN}
# Do not also set ANTHROPIC_API_KEY: Claude Code reports an auth conflict if both are set.

# Model slots, most capable to quickest. Any model from https://huggingface.co/inference/models
# Optional suffix: :provider (e.g. :cerebras) pins a provider; :fastest (default), :cheapest, :preferred set a policy.
ANTHROPIC_DEFAULT_OPUS_MODEL=zai-org/GLM-5.1
ANTHROPIC_DEFAULT_SONNET_MODEL=google/gemma-4-31B-it:together
ANTHROPIC_DEFAULT_HAIKU_MODEL=openai/gpt-oss-120b:cerebras
CLAUDE_CODE_SUBAGENT_MODEL=zai-org/GLM-5.1

# Optional: bill a Hugging Face Team/Enterprise org instead of your personal account.
# ANTHROPIC_CUSTOM_HEADERS="X-HF-Bill-To: your-org-name"
