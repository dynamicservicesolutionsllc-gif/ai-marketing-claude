# Apache/LiteSpeed rules for Hostinger. Copied into public/ by build.py.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One canonical address: https://kitchenfindsfavorites.com (no www, always HTTPS).
  # Redirects when the host is www, or when neither the server nor Hostinger's proxy saw HTTPS.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://kitchenfindsfavorites.com%{REQUEST_URI} [L,R=301]
  # Private files are never served.
  RewriteRule ^(_private|kff-data)(/|$) - [F,L]
  RewriteRule ^kff-lib\.php$ - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # Posting routines load the site graphics cross-origin (canvas -> file upload).
  <FilesMatch "\.(png|webp|jpe?g|svg)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
